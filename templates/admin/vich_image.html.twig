{% if field.value.name %}
  {% if field.value.name matches '/\.svg$/' %}
    <div class="thumbnail">
      {{ vich_uploader_asset(entity.instance, field.property ~ 'File', entity.fqcn) }}
    </div>
  {% else %}
    {% set html_id = 'ea-lightbox-' ~ field.uniqueId %}
    <a href="#" class="ea-lightbox-thumbnail" data-ea-lightbox-content-selector="#{{ html_id }}">
      <img src="{{ vich_uploader_asset(entity.instance, field.property ~ 'File', entity.fqcn)|imagine_filter('admin_thumbnail') }}" alt="{{ entity.name }}" class="img-fluid">
    </a>

    <div id="{{ html_id }}" class="ea-lightbox">
      <img src="{{ vich_uploader_asset(entity.instance, field.property ~ 'File', entity.fqcn) }}" alt="{{ entity.name }}">
    </div>
  {% endif %}
{% else %}
  {% include '@EasyAdmin/label/empty.html.twig' %}
{% endif %}

